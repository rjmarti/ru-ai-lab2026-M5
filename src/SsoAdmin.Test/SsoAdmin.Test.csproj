<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    SsoAdmin.Test referencia SsoAdmin.API y SsoAdmin.Web (proyectos web) únicamente para poder
    instanciar WebApplicationFactory<Program> contra cada uno en los smoke tests / tests de
    integración de este proyecto. Es la misma excepción documentada en Block 1 para SsoAdmin.API,
    ahora extendida a SsoAdmin.Web (Block 3): ningún proyecto de producción referencia ninguno de
    los dos proyectos web.

    SsoAdmin.Web se referencia con Aliases=WebHost porque ambos proyectos web usan top-level
    statements: el compilador genera en los dos un tipo "Program" en el namespace global, y sin el
    alias el nombre queda ambiguo (CS0433) al referenciar ambos ensamblados desde el mismo
    proyecto de test.
  -->
  <ItemGroup>
    <ProjectReference Include="..\SsoAdmin.Application\SsoAdmin.Application.csproj" />
    <ProjectReference Include="..\SsoAdmin.Data\SsoAdmin.Data.csproj" />
    <ProjectReference Include="..\SsoAdmin.API\SsoAdmin.API.csproj" />
    <ProjectReference Include="..\SsoAdmin.Web\SsoAdmin.Web.csproj">
      <Aliases>WebHost</Aliases>
    </ProjectReference>
  </ItemGroup>

</Project>